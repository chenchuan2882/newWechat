.post {
  background: #fffefa;
  padding: 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid #ebece2;
  margin: 24rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #e5ecdf;
}
.placeholder {
  text-align: center;
  line-height: 66rpx;
}
.muted,
.tags {
  font-size: 23rpx;
  color: #859488;
}
.excerpt {
  margin: 22rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: pre-wrap;
}
.images {
  display: flex;
  gap: 10rpx;
  margin-top: 24rpx;
}
.images image {
  flex: 1;
  width: 0;
  height: 300rpx;
  border-radius: 18rpx;
}
.images image:not(:first-child) {
  height: 300rpx;
}
.actions {
  font-size: 24rpx;
  color: #47735a;
  border-top: 1rpx solid #edf0e7;
  padding-top: 22rpx;
  margin-top: 20rpx;
}

.images-3 .large {
  flex: 2;
  height: 300rpx;
}
.image-stack {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.image-stack image {
  flex: none;
  width: 100%;
  height: 145rpx !important;
}
.images-1 image {
  height: 350rpx;
}
