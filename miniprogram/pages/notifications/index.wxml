<view class="page"
  ><view class="title">与你有关的小消息</view
  ><view wx:for="{{items}}" wx:key="id" class="card"
    ><view>{{item.text}}</view
    ><view class="muted">{{item.created_at}}</view></view
  ><view wx:if="{{loading}}" class="skeleton" /><view
    wx:if="{{error}}"
    class="notice"
    bindtap="load"
    >{{error}} · 点击重试</view
  ><view
    wx:if="{{!loading &amp;&amp; !items.length &amp;&amp; !error}}"
    class="empty"
    >还没有新消息，安心享受生活吧。</view
  ></view
>
