<view class="page"
  ><view class="eyebrow">MY COLLECTION / 记录你与生活的连接</view
  ><view class="title"
    >{{kind==='posts'?'我的生活分享':kind==='wishes'?'我的退休愿望':'从生活中收藏的灵感'}}</view
  ><view wx:if="{{kind==='posts'}}"
    ><view class="row"
      ><view
        class="pill {{status==='published'?'active':''}}"
        data-id="published"
        bindtap="status"
        >发布中</view
      ><view
        class="pill {{status==='pending'?'active':''}}"
        data-id="pending"
        bindtap="status"
        >审核中</view
      ><view
        class="pill {{status==='rejected'?'active':''}}"
        data-id="rejected"
        bindtap="status"
        >已下线</view
      ></view
    ><view wx:for="{{posts}}" wx:key="id"
      ><post-card
        post="{{item}}"
        bind:open="openPost"
        bind:like="likePost"
        bind:collect="collectPost"
        bind:author="openAuthor"
      /><view class="row"
        ><text class="muted">被收藏 {{item.collect_count}} 次</text
        ><text class="link" data-id="{{item.id}}" bindtap="editPost">编辑</text
        ><text class="danger" data-id="{{item.id}}" bindtap="remove"
          >删除</text
        ></view
      ></view
    ></view
  ><view wx:for="{{items}}" wx:key="id" class="card"
    ><view class="body">{{item.content}}</view
    ><view class="muted">{{item.dimensionName}}</view
    ><view wx:if="{{kind==='collected'}}" class="muted"
      >{{item.source_deleted?'来自已删除内容':'来自
      @'+item.source_author}}</view
    ><view class="row actions"
      ><text class="muted">{{item.date}}</text
      ><text
        wx:if="{{kind==='wishes'}}"
        class="danger"
        data-id="{{item.id}}"
        bindtap="remove"
        >删除</text
      ><text
        wx:else=""
        class="link"
        data-id="{{item.dimension}}"
        bindtap="blueprint"
        >查看蓝图 →</text
      ></view
    ></view
  ><view wx:if="{{loading}}" class="skeleton" /><view
    wx:if="{{error}}"
    class="notice"
    bindtap="load"
    >{{error}} · 点击重试</view
  ><view
    wx:if="{{!loading &amp;&amp; !posts.length &amp;&amp; !items.length &amp;&amp; !error}}"
    class="empty"
    >还没有记录，去发现生活灵感吧。</view
  ><view wx:if="{{!hasMore}}" class="empty">已经到底啦 ～</view></view
>
